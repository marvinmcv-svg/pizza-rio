{
  "name": "pizza-rio",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de Pizza Río (Santa Cruz, Bolivia) + Ría, asistente de pedidos con IA (texto y voz).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {

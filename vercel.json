{
  "functions": {
    "api/ria.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Frame-Options", "value": "DENY" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sigue-tu-pizza/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" }] },
    { "source": "/js/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
